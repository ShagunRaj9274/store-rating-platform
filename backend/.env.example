# Server
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string
# Local (docker-compose): postgres://postgres:postgres@localhost:5432/store_rating
# Neon / Render: paste the connection string they give you
DATABASE_URL=postgres://postgres:postgres@localhost:5432/store_rating
# Set to true for hosted databases (Neon, Render, Supabase)
DB_SSL=false

# Auth — use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Initial admin account created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@storerating.com
SEED_ADMIN_PASSWORD=Admin@123
