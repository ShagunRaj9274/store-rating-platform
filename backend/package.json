{
  "name": "store-rating-api",
  "version": "1.0.0",
  "description": "REST API for the Store Rating Platform (Express + PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test": "node --test tests/unit/queryBuilder.test.js tests/unit/validators.test.js",
    "test:integration": "node --env-file=.env.test --test --test-concurrency=1 tests/integration/auth.test.js tests/integration/listing.test.js tests/integration/ratings.test.js tests/integration/roles.test.js",
    "test:all": "node --env-file=.env.test --test --test-concurrency=1 tests/unit/queryBuilder.test.js tests/unit/validators.test.js tests/integration/auth.test.js tests/integration/listing.test.js tests/integration/ratings.test.js tests/integration/roles.test.js",
    "coverage": "c8 --reporter=text --reporter=lcov --check-coverage --lines 80 npm run test:all",
    "lint": "eslint ."
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-http": "^11.1.0",
    "store-rating-platform": "file:..",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0"
  }
}
